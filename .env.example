# ADMIN_PASSWORD: password for the CMS panel (gear icon in the navbar).
# REQUIRED — if unset, the admin panel is disabled entirely and every
# /api/admin/* write is rejected. The password never reaches the browser.
ADMIN_PASSWORD="CHANGE_ME"

# DATA_DIR: where admin edits are persisted (defaults to ./data).
# DATA_DIR="/mnt/data"

# FB_PAGE_ID / FB_PAGE_ACCESS_TOKEN: required to load REAL posts from the
# café's Facebook Page via the Graph API. Create a long-lived Page Access Token
# in the Meta Developer console (permissions: pages_read_engagement,
# pages_read_user_content) and paste it here.
# Without a token the gallery shows clearly-labelled sample content.
FB_PAGE_ID="61584459111985"
FB_PAGE_ACCESS_TOKEN="MY_FB_PAGE_ACCESS_TOKEN"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
