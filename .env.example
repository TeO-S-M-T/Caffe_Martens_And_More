# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FB_PAGE_ID / FB_PAGE_ACCESS_TOKEN: required to load REAL posts from the
# café's Facebook Page via the Graph API. Create a long-lived Page Access Token
# in the Meta Developer console (permissions: pages_read_engagement,
# pages_read_user_content) and paste it here.
# Without a token the gallery shows clearly-labelled sample content.
FB_PAGE_ID="61584459111985"
FB_PAGE_ACCESS_TOKEN="MY_FB_PAGE_ACCESS_TOKEN"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
